# Build image for the Windows half of packaging/build.sh: Windows Python (for PyInstaller) and
# Inno Setup (for the installer) run under Wine, so Windows builds need no Windows machine.
# Python is installed from its component MSIs: the .exe bootstrapper does not run under Wine.
# Wine comes from WineHQ: Debian's 10.0 lacks ucrtbase's crealf, which numpy's OpenBLAS calls on import.
FROM debian:trixie-slim
ARG WINE_VERSION=11.0.0.0~trixie-1
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gpg \
    && curl -fsSL https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /usr/share/keyrings/winehq.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/winehq.gpg] https://dl.winehq.org/wine-builds/debian trixie main' \
        > /etc/apt/sources.list.d/winehq.list \
    && apt-get update \
    && apt-get install -y --install-recommends \
        "winehq-stable=$WINE_VERSION" "wine-stable=$WINE_VERSION" \
        "wine-stable-amd64=$WINE_VERSION" "wine-stable-i386=$WINE_VERSION" \
    && apt-get install -y --no-install-recommends xvfb xauth python3-pil \
    && rm -rf /var/lib/apt/lists/*

ENV WINEPREFIX=/opt/wine WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml="
ARG PYTHON_VERSION=3.13.16
RUN set -e; mkdir /tmp/python; cd /tmp/python; \
    for msi in core exe lib tcltk; do \
        curl -fsSLO "https://www.python.org/ftp/python/$PYTHON_VERSION/amd64/$msi.msi"; \
    done; \
    printf '%s\n' \
        '507599467fafc5e8783961bd76db6e5a206d58bc968f06728c8a3865fc7337af  core.msi' \
        'fa39afc12c0778464273167046d7755c93902ecbc2293682724fdb7023f07cca  exe.msi' \
        'ee15c9b1cd71465a60f7a37cf0528e0446398ff94020c0075514c43ab0655d3f  lib.msi' \
        '968fc0acb37c42439ae4cf96181ee2e8148a89a22707414d980f7a2a84c2e67b  tcltk.msi' \
        | sha256sum -c --quiet; \
    wineboot --init; \
    for msi in core exe lib tcltk; do wine msiexec /i "$msi.msi" /qn TARGETDIR='C:\Python'; done; \
    wine 'C:\Python\python.exe' -m ensurepip --default-pip; \
    wineserver -w; \
    rm -rf /tmp/python

ARG INNO_SETUP_VERSION=6.7.3
RUN set -e; cd /tmp; \
    curl -fsSLo innosetup.exe "https://github.com/jrsoftware/issrc/releases/download/is-$(echo $INNO_SETUP_VERSION | tr . _)/innosetup-$INNO_SETUP_VERSION.exe"; \
    echo '9c73c3bae7ed48d44112a0f48e66742c00090bdb5bef71d9d3c056c66e97b732  innosetup.exe' | sha256sum -c --quiet; \
    xvfb-run -a wine innosetup.exe /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /DIR='C:\InnoSetup'; \
    wineserver -w; \
    rm innosetup.exe; \
    test -f "$WINEPREFIX/drive_c/InnoSetup/ISCC.exe"
